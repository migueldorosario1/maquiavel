        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "pt",
            "es"
          ]
        },
        "par_trilingue": {
          "type": "string"
        },
        "secao": {
          "type": "string",
          "enum": [
            "Essays",
            "Interviews",
            "Curation",
            "Dossiers",
            "Reviews"
          ],
          "default": "Essays"
        },
        "autor": {
          "type": "string",
          "default": "Maquiavel"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fonte_curadoria": {
          "type": "string"
        },
        "licenca_fonte": {
          "type": "string"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "pubDate",
        "lang",
        "par_trilingue"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}